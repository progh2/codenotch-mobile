<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/codenotch_usage_widget_name"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_ring_preview" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/widget_usage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/codenotch_usage_widget_placeholder_usage"
            android:textColor="@color/widget_percent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/codenotch_usage_widget_placeholder_label"
            android:textColor="@color/widget_label"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
